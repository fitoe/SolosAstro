---
import { siteConfig } from '../config/site';
---

<header class="border-b border-edge/80 bg-bg/90 backdrop-blur">
  <div class="content-shell flex items-center justify-between gap-6 py-4">
    <a class="flex items-center gap-3 text-sm font-semibold text-ink no-underline" href="/">
      <span class="inline-flex size-9 items-center justify-center rounded-full bg-tint/12 text-tintStrong">
        <span class="i-lucide:sparkles size-4.5" aria-hidden="true"></span>
      </span>
      <span>{siteConfig.title}</span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-5 text-sm text-muted">
      <a class="transition hover:text-ink" href="/posts">Posts</a>
      <a
        class="inline-flex items-center gap-2 transition hover:text-ink"
        href={siteConfig.social.github}
        rel="noreferrer"
        target="_blank"
      >
        <span class="i-simple-icons:github size-4" aria-hidden="true"></span>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
