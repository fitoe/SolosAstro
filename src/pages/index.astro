---
import { getCollection } from 'astro:content';

import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const latestPosts = (await getCollection('posts'))
  .sort((left, right) => right.data.date.getTime() - left.data.date.getTime())
  .slice(0, 2);
---

<BaseLayout>
  <section class="content-shell grid gap-12 py-16 sm:py-20 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-16">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-edge bg-surface px-3 py-1 text-sm text-muted">
        <span class="i-lucide:rocket size-4 text-tintStrong" aria-hidden="true"></span>
        <span>Astro 6 起手模板</span>
      </div>

      <div class="space-y-5">
        <h1 class="max-w-[12ch] text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          {siteConfig.title}
        </h1>
        <p class="max-w-[58ch] text-base leading-8 text-muted sm:text-lg">
          {siteConfig.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition hover:translate-y-[-1px]"
          href="/posts"
        >
          <span>查看文章</span>
          <span class="i-lucide:arrow-right size-4" aria-hidden="true"></span>
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-edge px-5 py-3 text-sm font-medium text-ink transition hover:bg-surface"
          href={siteConfig.social.github}
          rel="noreferrer"
          target="_blank"
        >
          <span class="i-simple-icons:github size-4" aria-hidden="true"></span>
          <span>查看模板</span>
        </a>
      </div>
    </div>

    <aside class="surface-card p-6 sm:p-7">
      <div class="space-y-5">
        <div class="flex items-center gap-3">
          <span class="inline-flex size-10 items-center justify-center rounded-full bg-tint/12 text-tintStrong">
            <span class="i-lucide:book-open-text size-5" aria-hidden="true"></span>
          </span>
          <div>
            <p class="text-sm text-muted">默认包含</p>
            <h2 class="text-lg font-semibold text-ink">最小内容工作流</h2>
          </div>
        </div>

        <ul class="space-y-3 text-sm leading-7 text-muted">
          <li>一个内容集合，Schema 保持最小。</li>
          <li>静态优先页面，带一层很薄的 SEO 默认值。</li>
          <li>使用 UnoCSS utility，并只暴露少量样式 token。</li>
        </ul>
      </div>
    </aside>
  </section>

  <section class="content-shell pb-16 sm:pb-20">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm text-muted">最新文章</p>
        <h2 class="text-2xl font-semibold tracking-tight">从一个真实可改的起点开始</h2>
      </div>
      <a class="text-sm font-medium text-ink hover:text-tintStrong" href="/posts">查看全部</a>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {latestPosts.map((entry) => <PostCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
